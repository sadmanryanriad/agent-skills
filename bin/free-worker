#!/usr/bin/env bash
# ==============================================================================
# free-worker — Lightweight Subagent Runner for Claude Code & Antigravity CLI
# Powered by OpenCode & OpenRouter Free/Stealth Models
# ==============================================================================

set -euo pipefail

# Ensure PATH includes opencode and local bin
export PATH="/home/riad/.opencode/bin:/home/riad/.local/bin:$PATH"

# Load OpenRouter API key if available
if [[ -z "${OPENROUTER_API_KEY:-}" ]]; then
    if [[ -f "$HOME/.config/opencode/.env" ]]; then
        # shellcheck disable=SC1091
        source "$HOME/.config/opencode/.env"
    fi
fi

DEFAULT_MODEL="opencode/deepseek-v4.1-flash-free"
MODEL="${FREE_WORKER_MODEL:-$DEFAULT_MODEL}"
AGENT="build"
AUTO_APPROVE=true
TIMEOUT_SEC=120
EXTRA_ARGS=()
PROMPT_PARTS=()

show_help() {
    cat << 'EOF'
Usage: free-worker [options] "your prompt here"

A resource-governed worker subagent running free/stealth models for Claude Code & Antigravity.

Options:
  -m, --model <name>       Model to use (default: opencode/deepseek-v4.1-flash-free)
  -a, --agent <plan|build> Agent mode: 'plan' (read-only research) or 'build' (file editing, default)
      --no-auto            Require manual confirmation before tool actions (default: auto-approve)
  -t, --timeout <sec>      Execution timeout in seconds (default: 120s)
  -f, --file <path>        Attach a file context to the prompt
  -l, --list-models        Show real-time table of available free models + context sizes
  -h, --help               Show this help message

Examples:
  free-worker -l
  free-worker "Draft 5 pytest unit tests for app/torrent_sentinel.py"
  free-worker -m openrouter/google/gemma-4-31b-it:free "Refactor function x"
  free-worker -a plan "Find all router API callers"
EOF
}

list_models() {
    python3 -c '
import urllib.request, json

hdr_model = "PROVIDER/MODEL"
hdr_ctx = "CONTEXT"
hdr_desc = "DESCRIPTION"
print(f"{hdr_model:<52} | {hdr_ctx:<10} | {hdr_desc}")
print("-" * 90)

builtin = [
    ("opencode/deepseek-v4.1-flash-free", "128k", "DeepSeek Flash (OpenCode Free, ultra fast)"),
    ("opencode/glm-5.3-flash-free", "128k", "GLM Flash (OpenCode Free)"),
    ("opencode/big-pickle", "128k", "Big Pickle (OpenCode Free)"),
    ("opencode/mimo-v2.6-flash-free", "128k", "Mimo Flash (OpenCode Free)"),
]
for m, ctx, desc in builtin:
    print(f"{m:<52} | {ctx:<10} | {desc}")

try:
    req = urllib.request.Request("https://openrouter.ai/api/v1/models")
    with urllib.request.urlopen(req, timeout=5) as resp:
        data = json.loads(resp.read().decode())
        free_models = [m for m in data.get("data", []) if ":free" in m.get("id", "") or m.get("id") == "openrouter/free"]
        for m in free_models:
            mid = "openrouter/" + m["id"]
            ctx_tokens = m.get("context_length", 0)
            ctx = f"{ctx_tokens // 1000}k" if ctx_tokens else "unknown"
            name = m.get("name", "")
            print(f"{mid:<52} | {ctx:<10} | {name}")
except Exception as e:
    print(f"Notice: OpenRouter live check failed: {e}")
'
}

# Parse command line options
while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            show_help
            exit 0
            ;;
        -l|--list-models|--live-models)
            list_models
            exit 0
            ;;
        -m|--model)
            MODEL="$2"
            shift 2
            ;;
        -a|--agent)
            AGENT="$2"
            shift 2
            ;;
        --no-auto)
            AUTO_APPROVE=false
            shift
            ;;
        -t|--timeout)
            TIMEOUT_SEC="$2"
            shift 2
            ;;
        -f|--file)
            EXTRA_ARGS+=(--file "$2")
            shift 2
            ;;
        --)
            shift
            PROMPT_PARTS+=("$@")
            break
            ;;
        *)
            PROMPT_PARTS+=("$1")
            shift
            ;;
    esac
done

PROMPT="${PROMPT_PARTS[*]:-}"

if [[ -z "$PROMPT" ]]; then
    echo "Error: No prompt provided." >&2
    echo "Run 'free-worker --help' for usage, or 'free-worker -l' to view live free models." >&2
    exit 1
fi

CMD_ARGS=(
    opencode run
    --model "$MODEL"
    --agent "$AGENT"
)

if [[ "$AUTO_APPROVE" = true ]]; then
    CMD_ARGS+=(--auto)
fi

if [[ ${#EXTRA_ARGS[@]} -gt 0 ]]; then
    CMD_ARGS+=("${EXTRA_ARGS[@]}")
fi

CMD_ARGS+=("$PROMPT")

# Resource governance: Clamp to 512MB RAM and 60% CPU on Asus Homelab
if command -v systemd-run >/dev/null 2>&1 && systemctl --user is-active basic.target >/dev/null 2>&1; then
    RUNNER=(systemd-run --user --scope -p MemoryMax=512M -p CPUQuota=60% --quiet)
else
    RUNNER=()
fi

# Execute with timeout
if ! timeout "${TIMEOUT_SEC}s" "${RUNNER[@]}" "${CMD_ARGS[@]}"; then
    EXIT_CODE=$?
    if [[ $EXIT_CODE -eq 124 ]]; then
        echo "Error: Worker timed out after ${TIMEOUT_SEC}s on model '$MODEL'." >&2
        echo "The model may be queued or unresponsive. Ask user permission to switch to another free model (e.g. opencode/deepseek-v4.1-flash-free or openrouter/openrouter/free)." >&2
    fi
    exit $EXIT_CODE
fi
